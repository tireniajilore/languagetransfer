  "segments": [
    { "kind": "line", "lang": "en", "say": "Spanish has five vowel sounds. English has about twenty. That's why Spanish is easier than you think.", "show": "5 Spanish sounds\nvs ~20 English", "audio": "hook-a" },
    { "kind": "line", "lang": "en", "say": "English vowels are chaos.", "show": "English vowels\nare chaos", "audio": "seg-01" },
    { "kind": "line", "lang": "en", "say": "A says apple. May. About. One letter, three sounds.", "show": "A\napple · may · about", "audio": "seg-02" },
    { "kind": "line", "lang": "en", "say": "Spanish vowels never move. Five sounds, locked.", "show": "Spanish vowels\nnever move", "audio": "seg-03" },
    { "kind": "vowels", "lang": "es", "say": "a, e, i, o, u.", "audio": "seg-04" },
    { "kind": "prompt", "lang": "en", "say": "Take the English word natural.", "word": "natural", "audio": "seg-05" },
    { "kind": "reveal", "lang": "es", "say": "En español, natural.", "word": "natural", "phon": "na-too-RAL", "audio": "seg-06" },
    { "kind": "prompt", "lang": "en", "say": "Take the English word metal.", "word": "metal", "audio": "seg-07" },
    { "kind": "reveal", "lang": "es", "say": "En español, metal.", "word": "metal", "phon": "meh-TAL", "audio": "seg-08" },
    { "kind": "prompt", "lang": "en", "say": "Take the English word legal.", "word": "legal", "audio": "seg-09" },
    { "kind": "reveal", "lang": "es", "say": "En español, legal.", "word": "legal", "phon": "leh-GAL", "audio": "seg-10" },
    { "kind": "prompt", "lang": "en", "say": "Take the English word ideal.", "word": "ideal", "audio": "seg-11" },
    { "kind": "reveal", "lang": "es", "say": "En español, ideal.", "word": "ideal", "phon": "ee-deh-AL", "audio": "seg-12" },
    { "kind": "line", "lang": "en", "say": "You didn't memorize four words.", "show": "you didn't memorize\nfour words", "audio": "seg-13" },
    { "kind": "line", "lang": "en", "say": "You learned five sounds, and now you can read all of them.", "show": "you learned\nfive sounds", "audio": "seg-14" }
  ],
  "caption": "Spanish has 5 vowel sounds. English has ~20. That's why reading Spanish out loud is easier: natural, metal, legal, ideal.",
