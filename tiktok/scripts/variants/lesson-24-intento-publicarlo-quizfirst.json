    {
      "kind": "line",
      "lang": "en",
      "say": "Intento can mean I try, or I am trying. Context does the rest.",
      "show": "intento =\nI try / I am trying",
      "audio": "seg-02"
    },
    {
      "kind": "line",
      "lang": "en",
      "say": "So keep the verb easy first. Prepare is preparar.",
      "show": "prepare -> preparar",
      "audio": "seg-03"
    },
    {
      "kind": "reveal",
      "lang": "es",
      "say": "En español, preparar.",
