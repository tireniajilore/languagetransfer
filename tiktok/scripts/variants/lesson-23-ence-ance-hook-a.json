    {
      "kind": "line",
      "lang": "en",
      "say": "When English ends in the ending spelled E N C E, Spanish often has encia.",
      "show": "English -ence\nSpanish -encia",
      "audio": "seg-01"
    },
    {
      "kind": "line",
      "lang": "en",
      "say": "Experience becomes experiencia.",
      "show": "experience -> experiencia",
      "audio": "seg-02"
    },
    {
      "kind": "reveal",
      "lang": "es",
      "say": "En español, experiencia.",
      "word": "experiencia",
      "phon": "eks-pe-ryen-SYA",
      "audio": "seg-03"
    },
    {
      "kind": "prompt",
      "lang": "en",
      "say": "You know different. Now try difference.",
      "word": "difference",
      "audio": "seg-04"
    },
    {
      "kind": "reveal",
      "lang": "es",
      "say": "En español, diferencia.",
      "word": "diferencia",
      "phon": "dee-fe-REN-sya",
      "audio": "seg-05"
    },
    {
      "kind": "prompt",
      "lang": "en",
      "say": "What about influence?",
      "word": "influence",
      "audio": "seg-06"
    },
