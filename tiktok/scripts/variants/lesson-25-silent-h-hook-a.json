{
  "id": "lesson-25-silent-h-hook-a",
  "title": "Spanish H Disappears (hook swap A)",
  "audioDir": "lesson-25-silent-h",
  "voice_notes": "Hook-swap variant - only the hook-a segment needs TTS; everything else reuses lesson-25-silent-h audio.",
  "segments": [
    {
      "kind": "line",
      "lang": "en",
      "say": "There's a letter in Spanish you should just ignore completely.",
      "show": "ignore\nthe h",
      "audio": "hook-a"
    },
    {
      "kind": "line",
      "lang": "en",
      "say": "The letter h is written, but it does not make a sound.",
      "show": "h is written\nnot spoken",
      "audio": "seg-01"
    },
    {
      "kind": "line",
      "lang": "en",
      "say": "C H together still makes the ch sound. But a plain h disappears.",
      "show": "ch is different\nplain h disappears",
      "audio": "seg-02"
    },
    {
      "kind": "line",
      "lang": "en",
      "say": "Do not even give it a tiny breath. Imagine the word starts with the next vowel.",
      "show": "no breath\nstart at the vowel",
      "audio": "seg-03"
    },
    {
      "kind": "prompt",
      "lang": "en",
      "say": "Try the word hospital, with no h sound.",
      "word": "hospital",
      "audio": "seg-04"
    },
    {
      "kind": "reveal",
      "lang": "es",
      "say": "En español, hospital.",
      "word": "hospital",
      "phon": "os-pee-TAL",
      "audio": "seg-05"
    },
    {
      "kind": "prompt",
      "lang": "en",
      "say": "Now horrible. No h sound.",
      "word": "horrible",
      "audio": "seg-06"
    },
    {
      "kind": "reveal",
      "lang": "es",
      "say": "En español, horrible.",
      "word": "horrible",
      "phon": "o-RREE-ble",
      "audio": "seg-07"
    },
    {
      "kind": "prompt",
      "lang": "en",
      "say": "What about habitual?",
      "word": "habitual",
      "audio": "seg-08"
    },
    {
      "kind": "reveal",
      "lang": "es",
      "say": "En español, habitual.",
      "word": "habitual",
      "phon": "a-bee-TWAL",
      "audio": "seg-09"
    },
    {
      "kind": "line",
      "lang": "en",
      "say": "And if you add mente, the h still stays silent.",
      "show": "habitual + mente",
      "audio": "seg-10"
    },
    {
      "kind": "prompt",
      "lang": "en",
      "say": "Say habitually.",
      "word": "habitually",
      "audio": "seg-11"
    },
    {
      "kind": "reveal",
      "lang": "es",
      "say": "En español, habitualmente.",
      "word": "habitualmente",
      "phon": "a-bee-twal-MEN-te",
      "audio": "seg-12"
    },
    {
      "kind": "line",
      "lang": "en",
      "say": "The word for now also hides one of these silent h's.",
      "show": "now = ahora",
      "audio": "seg-13"
    },
    {
      "kind": "reveal",
      "lang": "es",
      "say": "Ahora.",
      "word": "ahora",
      "phon": "a-O-ra",
      "audio": "seg-14"
    },
    {
      "kind": "line",
      "lang": "en",
      "say": "Good. The letter is there for your eyes, not your mouth.",
      "show": "for your eyes\nnot your mouth",
      "audio": "seg-15"
    }
  ],
  "caption": "There's a letter in Spanish you should just ignore: hospital, horrible, habitual - silent h.",
