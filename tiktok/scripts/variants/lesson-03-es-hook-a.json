    { "kind": "reveal", "lang": "es", "say": "Es ideal.", "word": "Es ideal", "phon": "es i-de-AL", "audio": "seg-14" },
    { "kind": "line", "lang": "en", "say": "He, she, it. Spanish does not care here. We just use es.", "show": "he / she / it\nes", "audio": "seg-15" }
  ],
  "caption": "The first Spanish word I'd learn if I started over: es. It builds sentences instantly — es normal, es legal, es ideal.",
