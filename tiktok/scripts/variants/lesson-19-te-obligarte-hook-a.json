    },
    {
      "kind": "line",
      "lang": "en",
      "say": "Here, te means you.",
      "show": "te = you",
      "audio": "seg-02"
    },
    {
      "kind": "line",
      "lang": "en",
      "say": "Start with inform. In Spanish, informar.",
      "show": "information -> informar",
      "audio": "seg-03"
    },
    {
      "kind": "line",
      "lang": "es",
      "say": "Informar.",
      "show": "informar",
      "audio": "seg-04"
    },
    {
      "kind": "line",
      "lang": "en",
      "say": "Attach te at the end.",
      "show": "informar + te",
      "audio": "seg-05"
    },
    {
      "kind": "prompt",
      "lang": "en",
      "say": "Say: to inform you.",
