{
  "id": "lesson-15-acion-to-ar",
  "title": "Turn ACION Words Into Verbs",
  "voice_notes": "Warm, patient teacher. One voice. Brian v3. English prompts use language_code en; Spanish reveals use language_code es. Avoid Language Transfer branding.",
  "segments": [
    {
      "kind": "line",
      "lang": "en",
      "say": "One English ation word can give you a Spanish noun and a Spanish verb.",
      "show": "one English word\ntwo Spanish words"
    },
    {
      "kind": "line",
      "lang": "en",
      "say": "First, the English ending ation.",
      "show": "English:\n-ation"
    },
    {
      "kind": "line",
      "lang": "es",
      "say": "En español, ación.",
      "show": "Spanish:\n-ación"
    },
    {
      "kind": "line",
      "lang": "en",
      "say": "Then take that ending off, and add ar.",
      "show": "take off ción\nadd ar"
    },
    {
      "kind": "line",
      "lang": "es",
      "say": "Preparación.",
      "show": "preparación"
    },
    {
      "kind": "line",
      "lang": "en",
      "say": "That is preparation.",
      "show": "preparation"
    },
    {
      "kind": "line",
      "lang": "es",
      "say": "Preparar.",
      "show": "preparar"
    },
    {
      "kind": "line",
      "lang": "en",
      "say": "That is to prepare.",
      "show": "to prepare"
    },
    {
      "kind": "prompt",
      "lang": "en",
      "say": "Try this one: generation.",
      "word": "generation"
    },
    {
      "kind": "reveal",
      "lang": "es",
      "say": "Generación.",
      "word": "generación",
      "phon": "he-ne-ra-SYON"
    },
    {
      "kind": "prompt",
      "lang": "en",
      "say": "Now turn it into: to generate.",
      "word": "to generate"
    },
    {
      "kind": "reveal",
      "lang": "es",
      "say": "Generar.",
      "word": "generar",
      "phon": "he-ne-RAR"
    },
    {
      "kind": "prompt",
      "lang": "en",
      "say": "What about confirmation?",
      "word": "confirmation"
    },
    {
      "kind": "reveal",
      "lang": "es",
      "say": "Confirmación.",
      "word": "confirmación",
      "phon": "kon-feer-ma-SYON"
    },
    {
      "kind": "prompt",
      "lang": "en",
      "say": "Now: to confirm.",
      "word": "to confirm"
    },
    {
      "kind": "reveal",
      "lang": "es",
      "say": "Confirmar.",
      "word": "confirmar",
      "phon": "kon-feer-MAR"
    },
    {
      "kind": "prompt",
      "lang": "en",
      "say": "One more: complication.",
      "word": "complication"
    },
    {
      "kind": "reveal",
      "lang": "es",
      "say": "Complicación.",
      "word": "complicación",
      "phon": "kom-plee-ka-SYON"
    },
    {
      "kind": "prompt",
      "lang": "en",
      "say": "Now: to complicate.",
      "word": "to complicate"
    },
    {
      "kind": "reveal",
      "lang": "es",
      "say": "Complicar.",
      "word": "complicar",
      "phon": "kom-plee-KAR"
    },
    {
      "kind": "line",
      "lang": "en",
      "say": "Good. You did not learn four verbs. You unlocked a pattern.",
      "show": "not four verbs\na pattern"
    }
  ],
  "caption": "One English -ation word can give you two Spanish words: preparación -> preparar, generación -> generar.",
  "hashtags": ["learnspanish", "spanishtok", "spanish", "languagelearning", "studytok"]
}
