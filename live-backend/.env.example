# Required: OpenAI project API key WITH GPT-Live access.
# Set in the Railway dashboard (service Variables), never commit a value.
OPENAI_API_KEY=

# Port the service listens on. Railway injects PORT automatically.
PORT=8080

# Comma-separated origin allowlist for POST /api/live/session.
# Example: https://languagetransfer.vercel.app,https://lt.example.com
# Empty = allow all (dev only; logs a warning).
ALLOWED_ORIGIN=

# Session-mint rate limit: max sessions per window per client IP.
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000

# GPT-Live voice model for new sessions.
LIVE_MODEL=gpt-live-1

# Soft-control instructions attached to every session at creation.
# Leave empty to use the built-in Spanish Thinking-Method preamble.
LIVE_SESSION_INSTRUCTIONS=

# Backend reasoning model for Responses delegation (Layer C).
# Default gpt-5.6-terra; gpt-5.6-luna is the cost-sensitive alternative.
LIVE_DELEGATION_MODEL=gpt-5.6-terra

# Set to 1 to mint sessions WITHOUT Responses delegation (tests/debug only).
LIVE_DELEGATION_DISABLED=

# Max sideband reconnect attempts on unexpected drops.
SIDEBAND_MAX_RECONNECT_ATTEMPTS=5

# Override for tests pointed at a mock Live API (do not set in production).
OPENAI_API_BASE_URL=
