    },
    {
      "kind": "line",
      "lang": "es",
      "say": "Te quiero.",
      "show": "Te quiero."
    },
    {
      "kind": "line",
      "lang": "en",
      "say": "Literally, that is I want you.",
      "show": "literally:\nI want you"
    },
    {
      "kind": "line",
      "lang": "es",
      "say": "Quiero.",
      "show": "Quiero."
    },
    {
      "kind": "line",
