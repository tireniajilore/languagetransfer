    {
      "kind": "reveal",
      "lang": "es",
      "say": "Quiero.",
      "word": "Quiero",
      "phon": "KYE-ro"
    },
    {
      "kind": "line",
      "lang": "en",
      "say": "To make it negative, Spanish does one very kind thing.",
      "show": "to make it negative"
    },
    {
      "kind": "line",
      "lang": "en",
      "say": "Park no in front.",
      "show": "park no\nin front"
    },
    {
      "kind": "prompt",
      "lang": "en",
      "say": "Now say: I do not want.",
      "word": "I don't want"
    },
    {
      "kind": "reveal",
      "lang": "es",
      "say": "No quiero.",
      "word": "No quiero",
      "phon": "no KYE-ro"
    },
    {
      "kind": "line",
      "lang": "en",
      "say": "Now make it a full sentence. Coffee is café, with Spanish sound.",
      "show": "make it\na full sentence"
    },
    {
      "kind": "line",
      "lang": "es",
      "say": "Café.",
      "show": "café"
