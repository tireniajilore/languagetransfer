  "segments": [
    {
      "kind": "line",
      "lang": "en",
      "say": "You may already know how to say I love you in Spanish.",
      "show": "you may already know\nI love you"
    },
    {
      "kind": "line",
      "lang": "en",
      "say": "Hidden inside it is one of the most useful Spanish phrases.",
