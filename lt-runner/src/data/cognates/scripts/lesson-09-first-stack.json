    {
      "kind": "prompt",
      "lang": "en",
      "word": "important",
      "pauseSec": 1
    },
    {
      "kind": "reveal",
      "lang": "es",
      "say": "En español: importante.",
      "word": "importante",
      "phon": "im-por-TAN-te"
    },
    {
      "kind": "prompt",
      "lang": "en",
      "say": "It is important.",
