      "pauseSec": 3
    },
    {
      "kind": "reveal",
      "lang": "es",
      "say": "En español: Realmente es urgente.",
      "word": "Realmente es urgente",
      "phon": "re-al-MEN-te es ur-HEN-te"
    },
    {
      "kind": "prompt",
      "lang": "en",
      "say": "Really, it is important.",
      "word": "really, it is important",
      "pauseSec": 3
    },
    {
      "kind": "reveal",
      "lang": "es",
      "say": "En español: Realmente es importante.",
