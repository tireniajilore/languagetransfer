    {
      "kind": "prompt",
      "lang": "en",
      "word": "it is",
      "pauseSec": 0.9
    },
    {
      "kind": "reveal",
      "lang": "es",
      "say": "En español: Es.",
      "word": "Es",
      "phon": "es"
    },
    {
      "kind": "line",
      "lang": "en",
      "say": "The English word urgent changes in Spanish.",
      "show": "urgent\nurgente"
    },
    {
      "kind": "prompt",
      "lang": "en",
      "word": "urgent",
      "pauseSec": 1
    },
    {
      "kind": "reveal",
      "lang": "es",
      "say": "En español: urgente.",
      "word": "urgente",
      "phon": "ur-HEN-te"
    },
    {
      "kind": "line",
      "lang": "en",
      "say": "Now use both pieces.",
      "show": "use both pieces"
    },
    {
      "kind": "prompt",
      "lang": "en",
      "say": "It is urgent.",
      "word": "it is urgent",
      "pauseSec": 2.3
    },
    {
      "kind": "reveal",
      "lang": "es",
      "say": "En español: Es urgente.",
      "word": "Es urgente",
      "phon": "es ur-HEN-te"
    },
    {
      "kind": "line",
      "lang": "en",
      "say": "Important changes the same way.",
