      "phon": "es im-por-TAN-te"
    },
    {
      "kind": "line",
      "lang": "en",
      "say": "For many English words that end in L Y, Spanish uses mente.",
      "show": "English: ly\nSpanish: mente"
    },
    {
      "kind": "line",
      "lang": "en",
      "say": "Real becomes really.",
      "show": "real\nreally"
    },
    {
      "kind": "line",
      "lang": "es",
      "say": "En español: real. En español: realmente.",
      "show": "real\nrealmente"
    },
    {
      "kind": "line",
      "lang": "en",
      "say": "Now build it.",
      "show": "now build it"
    },
    {
      "kind": "prompt",
      "lang": "en",
      "say": "Really, it is urgent.",
