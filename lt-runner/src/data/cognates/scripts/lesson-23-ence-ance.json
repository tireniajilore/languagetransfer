    {
      "kind": "reveal",
      "lang": "es",
      "say": "En español, consistencia.",
      "word": "consistencia",
      "phon": "kon-sees-TEN-sya"
    },
    {
      "kind": "line",
      "lang": "en",
      "say": "Good. You are not memorizing nouns. You are collecting word machines.",
      "show": "not memorizing\nword machines"
