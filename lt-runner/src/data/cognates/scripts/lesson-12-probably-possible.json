{
  "id": "lesson-12-probably-possible",
  "title": "Probablemente Possible Stack",
  "voice_notes": "Warm, patient teacher. One voice. Brian v3. English prompts use language_code en; Spanish reveals use language_code es. Avoid bare cognates. English prompts should stay fully English; Spanish answers use En español carriers.",
  "segments": [
    {
      "kind": "line",
