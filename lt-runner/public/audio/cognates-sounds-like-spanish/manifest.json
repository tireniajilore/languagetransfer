    "lesson-02-vowels-segment-1": {
      "segments": [
        {
          "text": "Reading Spanish out loud is way easier than English. Here's the reason.",
          "lang": "en",
          "file": "lesson-02-vowels-segment-1-1.mp3",
          "hash": "05b107189a6edc040600c58ccd0c73e3388ebf64f6dc2958afb4d47f1d046499"
        }
      ]
    },
    "lesson-02-vowels-segment-2": {
      "segments": [
        {
          "text": "English vowels are chaos.",
          "lang": "en",
          "file": "lesson-02-vowels-segment-2-1.mp3",
          "hash": "de1aa26795bbdcdd03a4a92f4f90a70ce48438fdc3739734fb489e08953747eb"
        }
      ]
    },
    "lesson-02-vowels-segment-3": {
      "segments": [
        {
          "text": "A says apple. May. About. One letter, three sounds.",
          "lang": "en",
          "file": "lesson-02-vowels-segment-3-1.mp3",
          "hash": "f0e8a1200ac2905f64481bb5b52501b5d02b133402868d9e53000007a24c1640"
        }
      ]
    },
    "lesson-02-vowels-segment-4": {
      "segments": [
        {
          "text": "Spanish vowels never move. Five sounds, locked.",
          "lang": "en",
          "file": "lesson-02-vowels-segment-4-1.mp3",
          "hash": "9920655b6f9b43b71d4c4e7aa0759c48fd9e25bbda2a844b0dc8a2c5ea435e75"
        }
      ]
    },
    "lesson-02-vowels-segment-5": {
      "segments": [
        {
          "text": "a, e, i, o, u.",
          "lang": "es",
          "file": "lesson-02-vowels-segment-5-1.mp3",
          "hash": "a74ee2d30044011868573ebe3b8742c0732054ea3a4602ac67c5edd3a257eca4"
        }
      ]
    },
    "lesson-02-vowels-segment-6": {
      "segments": [
        {
          "text": "Take the English word natural.",
          "lang": "en",
