    "lesson-03-es-segment-1": {
      "segments": [
        {
          "text": "One tiny Spanish word builds a whole pile of sentences. Here it is.",
          "lang": "en",
          "file": "lesson-03-es-segment-1-1.mp3",
          "hash": "ca90835511d2c922ba5b503d1d7f6b80336df650328f62b502b318fd6eecc311"
        }
      ]
    },
    "lesson-03-es-segment-2": {
      "segments": [
        {
          "text": "Es.",
          "lang": "es",
          "file": "lesson-03-es-segment-2-1.mp3",
          "hash": "21ba1368ceb9b4d1b1f1d250346070fca9286183114b488ef4d5351cad8fcf71"
        }
      ]
    },
    "lesson-03-es-segment-3": {
      "segments": [
        {
          "text": "That little word means is. Keep the S sound clean.",
          "lang": "en",
          "file": "lesson-03-es-segment-3-1.mp3",
          "hash": "f6fb40755afb4035ff4b69905ac2bc9d0b73931c49ff476020dc6a6a9992ad0c"
        }
      ]
    },
    "lesson-03-es-segment-4": {
      "segments": [
        {
          "text": "You already know words like normal, legal, and natural. So now put it together.",
          "lang": "en",
          "file": "lesson-03-es-segment-4-1.mp3",
          "hash": "8e169ad79042732bcf14c89d22bb82762923591bf1c2bd9aa2eb6f0fabe3905d"
        }
      ]
    },
    "lesson-03-es-segment-5": {
      "segments": [
        {
          "text": "How would you say: it is normal?",
          "lang": "en",
          "file": "lesson-03-es-segment-5-1.mp3",
          "hash": "f7115a89c991f613f2ee25de18bb47163350a7f63252025547d7057d3dd2da6b"
        }
      ]
    },
    "lesson-03-es-segment-6": {
      "segments": [
        {
          "text": "Es normal.",
          "lang": "es",
