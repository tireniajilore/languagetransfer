        }
      ]
    },
    "lesson-03-es-segment-8": {
      "segments": [
        {
          "text": "Es legal.",
          "lang": "es",
          "file": "lesson-03-es-segment-8-1.mp3",
          "hash": "43b0c8c7139e514045c476a3a9f3ecbcdf16e539c671906816b5308f9219b689"
        }
      ]
    },
    "lesson-03-es-segment-9": {
      "segments": [
        {
          "text": "How would you say: it is natural?",
          "lang": "en",
          "file": "lesson-03-es-segment-9-1.mp3",
