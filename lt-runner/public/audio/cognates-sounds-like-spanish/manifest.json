        }
      ]
    },
    "lesson-02-vowels-segment-12": {
      "segments": [
        {
          "text": "Take the English word ideal.",
          "lang": "en",
          "file": "lesson-02-vowels-segment-12-1.mp3",
          "hash": "bda1fec1ea472e5890bbc55c2c3a4e88d6f26227f76b4affee3340706352dcd7"
