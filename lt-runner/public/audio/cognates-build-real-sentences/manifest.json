        {
          "text": "En español: posible.",
          "lang": "es",
          "file": "lesson-12-probably-possible-segment-7-1.mp3",
          "hash": "aa768ba8412b0663c27c57725408609f727b552448b28b456c7937619723d30f"
        }
      ]
    },
    "lesson-12-probably-possible-segment-8": {
      "segments": [
        {
          "text": "It is possible.",
          "lang": "en",
          "file": "lesson-12-probably-possible-segment-8-1.mp3",
          "hash": "9f47b595e5c4fadd2376b9c1462d0e96cb683f6cf2f7aed6e8d7fa0b6529598d"
        }
      ]
    },
    "lesson-12-probably-possible-segment-9": {
      "segments": [
        {
          "text": "En español: Es posible.",
          "lang": "es",
          "file": "lesson-12-probably-possible-segment-9-1.mp3",
          "hash": "6e9995579268b9914cd5dba1b00894da5527bd2640bae640724ec4afce12cafa"
        }
      ]
    },
    "lesson-12-probably-possible-segment-10": {
      "segments": [
        {
          "text": "Probable barely changes.",
          "lang": "en",
          "file": "lesson-12-probably-possible-segment-10-1.mp3",
          "hash": "1d10efbadd13b491c3cdb762e06fa6dafdf5dae8564e94c93e26034f7054a565"
        }
      ]
    },
    "lesson-12-probably-possible-segment-11": {
      "segments": [
        {
          "text": "Say: probable",
          "lang": "en",
          "file": "lesson-12-probably-possible-segment-11-1.mp3",
          "hash": "533e5d6397a96d3be07ddb21e880c455c7852d3c72da9216a5f8b31020d6ecb0"
        }
      ]
    },
    "lesson-12-probably-possible-segment-12": {
      "segments": [
        {
          "text": "En español: probable.",
          "lang": "es",
          "file": "lesson-12-probably-possible-segment-12-1.mp3",
          "hash": "04e45bde8e364f8b1091bf5ab7efcb586f7399849aa58bb076db6dca8615fd85"
        }
      ]
    },
    "lesson-12-probably-possible-segment-13": {
      "segments": [
        {
          "text": "It is probable.",
          "lang": "en",
          "file": "lesson-12-probably-possible-segment-13-1.mp3",
          "hash": "a2f3358ff60276c702782e80308dd1e291f2fb8780d0d273ea28806ef5d1ae98"
        }
      ]
    },
    "lesson-12-probably-possible-segment-14": {
      "segments": [
        {
          "text": "En español: Es probable.",
          "lang": "es",
          "file": "lesson-12-probably-possible-segment-14-1.mp3",
          "hash": "8c085de452f1f2e6baddd8aae390481983e304efcbe4a2e4f6150c06f589a060"
        }
      ]
    },
    "lesson-12-probably-possible-segment-15": {
      "segments": [
        {
          "text": "For many English words that end in L Y, Spanish uses mente.",
          "lang": "en",
          "file": "lesson-12-probably-possible-segment-15-1.mp3",
          "hash": "c4155407639a5e12b53f2b6f648c939f2695a9f57b1a86e521d18e96ced78f69"
        }
      ]
    },
    "lesson-12-probably-possible-segment-16": {
      "segments": [
        {
          "text": "Probable becomes probably.",
          "lang": "en",
          "file": "lesson-12-probably-possible-segment-16-1.mp3",
          "hash": "7c0a86ca581eadce2bdd3ed7b39da1a33dff19f837d983f067e61a1c2e51f938"
        }
      ]
    },
    "lesson-12-probably-possible-segment-17": {
      "segments": [
        {
          "text": "En español: probable. En español: probablemente.",
          "lang": "es",
          "file": "lesson-12-probably-possible-segment-17-1.mp3",
          "hash": "fce66e7468a63cdf922e91275ba7f3fa3c21f0a92801e13b4041a04e1eb7ec9a"
        }
      ]
    },
    "lesson-12-probably-possible-segment-18": {
      "segments": [
        {
          "text": "Now build the bigger sentence.",
          "lang": "en",
          "file": "lesson-12-probably-possible-segment-18-1.mp3",
          "hash": "1728ffb53633db5fd858a962382c77d2259a4a2116c9ef976ccac18a4ecea44c"
        }
      ]
    },
    "lesson-12-probably-possible-segment-19": {
      "segments": [
        {
          "text": "Probably, it is possible.",
          "lang": "en",
          "file": "lesson-12-probably-possible-segment-19-1.mp3",
          "hash": "3463922d5d009235ccb2fd65b1def52fd218f81cbd81dae218e19ad5d7e68e18"
        }
      ]
    },
    "lesson-12-probably-possible-segment-20": {
      "segments": [
        {
          "text": "En español: Probablemente es posible.",
          "lang": "es",
          "file": "lesson-12-probably-possible-segment-20-1.mp3",
          "hash": "89412e34f53561d20f814139d77ab662b0c2c4388a6d54476281002b581148bd"
        }
      ]
    },
    "lesson-12-probably-possible-segment-21": {
      "segments": [
        {
          "text": "Last one. You have not seen this full sentence here, but you have the pieces.",
          "lang": "en",
          "file": "lesson-12-probably-possible-segment-21-1.mp3",
          "hash": "d87bf38a938100e62cc9275499fc15041a7ad0b6019c708ba3266a2c21eb5ddc"
        }
      ]
    },
    "lesson-12-probably-possible-segment-22": {
      "segments": [
        {
          "text": "Probably, it is important.",
          "lang": "en",
          "file": "lesson-12-probably-possible-segment-22-1.mp3",
          "hash": "f5201ed4d0da90e921a70407c1fbbbde7f555643d3ec1ab8c3dce8a3f7ea92f3"
        }
      ]
    },
    "lesson-12-probably-possible-segment-23": {
      "segments": [
        {
          "text": "En español: Probablemente es importante.",
          "lang": "es",
          "file": "lesson-12-probably-possible-segment-23-1.mp3",
          "hash": "a41af80ee04061ec82defe3e383ebcdffd61a862d3e52990d916dc8d78acec98"
        }
      ]
    },
    "lesson-12-probably-possible-segment-24": {
      "segments": [
        {
          "text": "Same pattern, new sentence.",
          "lang": "en",
          "file": "lesson-12-probably-possible-segment-24-1.mp3",
          "hash": "b89212b8417fc7df84581a1477f31e0bc767cd6fd4b613c53963a3ec9eabc93a"
        }
      ]
    },
    "lesson-13-quiero-no-quiero-segment-1": {
      "segments": [
        {
          "text": "You may already know how to say I love you in Spanish.",
          "lang": "en",
          "file": "lesson-13-quiero-no-quiero-segment-1-1.mp3",
          "hash": "3d0f02393886f014bd3c7e1c6d7d1825f811db46e628ac940f37b6416051ef24"
        }
      ]
    },
    "lesson-13-quiero-no-quiero-segment-2": {
      "segments": [
        {
          "text": "Hidden inside it is one of the most useful Spanish phrases.",
          "lang": "en",
          "file": "lesson-13-quiero-no-quiero-segment-2-1.mp3",
          "hash": "66f143a3c2dddcca221ebfdb7f118462bbf24bff2a80137509b6b17d3a64c713"
        }
      ]
    },
    "lesson-13-quiero-no-quiero-segment-3": {
      "segments": [
        {
          "text": "Te quiero.",
          "lang": "es",
          "file": "lesson-13-quiero-no-quiero-segment-3-1.mp3",
          "hash": "ca82ef8efa264802a570d5d1e935702b2c7ef87542ccb81eaab64f690f96fc51"
        }
      ]
    },
    "lesson-13-quiero-no-quiero-segment-4": {
      "segments": [
        {
          "text": "Literally, that is I want you.",
          "lang": "en",
          "file": "lesson-13-quiero-no-quiero-segment-4-1.mp3",
          "hash": "36568d128115a5a267873dc647494e46c0253ed612934bac537045e2ecdb093e"
        }
      ]
    },
    "lesson-13-quiero-no-quiero-segment-5": {
      "segments": [
        {
          "text": "Quiero.",
          "lang": "es",
          "file": "lesson-13-quiero-no-quiero-segment-5-1.mp3",
          "hash": "353e0a80b68bddbcea4a0dd11024f9712e530fafe3643453f814e3d8d889c638"
        }
      ]
    },
    "lesson-13-quiero-no-quiero-segment-6": {
      "segments": [
        {
          "text": "That means I want.",
          "lang": "en",
          "file": "lesson-13-quiero-no-quiero-segment-6-1.mp3",
          "hash": "00abc4cd4a2703d8a7bf16f514caea886837d63bd4a4db010b487376eaca50b1"
        }
      ]
    },
    "lesson-13-quiero-no-quiero-segment-7": {
      "segments": [
        {
          "text": "Your turn: I want.",
          "lang": "en",
          "file": "lesson-13-quiero-no-quiero-segment-7-1.mp3",
          "hash": "37084799bf8b45af336e31ece11e6aee7a7c5b0d75ed4d056872e8c6a54ff150"
        }
      ]
    },
    "lesson-13-quiero-no-quiero-segment-8": {
      "segments": [
        {
          "text": "Quiero.",
          "lang": "es",
          "file": "lesson-13-quiero-no-quiero-segment-8-1.mp3",
          "hash": "353e0a80b68bddbcea4a0dd11024f9712e530fafe3643453f814e3d8d889c638"
        }
      ]
    },
    "lesson-13-quiero-no-quiero-segment-9": {
      "segments": [
        {
          "text": "To make it negative, Spanish does one very kind thing.",
          "lang": "en",
          "file": "lesson-13-quiero-no-quiero-segment-9-1.mp3",
          "hash": "86976118121fdfc2b4afe507d652c5a145a6886560d7463b2b6c3e3564cf3b4e"
        }
      ]
    },
    "lesson-13-quiero-no-quiero-segment-10": {
      "segments": [
        {
          "text": "Park no in front.",
          "lang": "en",
          "file": "lesson-13-quiero-no-quiero-segment-10-1.mp3",
          "hash": "60cc7d3aff70d0e6ed313188670de50a8ea4b03a6cd646d840e85533c3ca51ae"
        }
      ]
    },
    "lesson-13-quiero-no-quiero-segment-11": {
      "segments": [
        {
          "text": "Now say: I do not want.",
          "lang": "en",
          "file": "lesson-13-quiero-no-quiero-segment-11-1.mp3",
          "hash": "4460b3ae5c11de1855ce66ad8c3b82203cd0d284d58c6b4ed84b9eb8d555a5f6"
        }
      ]
    },
    "lesson-13-quiero-no-quiero-segment-12": {
      "segments": [
        {
          "text": "No quiero.",
          "lang": "es",
          "file": "lesson-13-quiero-no-quiero-segment-12-1.mp3",
          "hash": "4c57d36989520af58c4c21a5044676aa6e829144228aa524d06ae9afd8942b0a"
        }
      ]
    },
    "lesson-13-quiero-no-quiero-segment-13": {
      "segments": [
        {
          "text": "Now make it a full sentence. Coffee is café, with Spanish sound.",
          "lang": "en",
          "file": "lesson-13-quiero-no-quiero-segment-13-1.mp3",
          "hash": "e7745b39bb5bf42d879b71719536a4c0e515d290e42c965986a8779074338c32"
        }
      ]
    },
    "lesson-13-quiero-no-quiero-segment-14": {
      "segments": [
        {
          "text": "Café.",
          "lang": "es",
          "file": "lesson-13-quiero-no-quiero-segment-14-1.mp3",
          "hash": "4ff0e8a873cc9d6fc0b7e72b5d289979e0da878ea21a3ffc15c691a29882101b"
        }
      ]
    },
    "lesson-13-quiero-no-quiero-segment-15": {
      "segments": [
        {
          "text": "Say: I want coffee.",
          "lang": "en",
          "file": "lesson-13-quiero-no-quiero-segment-15-1.mp3",
          "hash": "6318544ef1a0dad929cc132d588283c714fa793be267eaa6db038fd204cf20f0"
        }
      ]
    },
    "lesson-13-quiero-no-quiero-segment-16": {
      "segments": [
        {
          "text": "Quiero café.",
          "lang": "es",
          "file": "lesson-13-quiero-no-quiero-segment-16-1.mp3",
          "hash": "36ff3ea83d23a639df0e2dc2b728baaff73fa4ae0eed3e1308931e08f0c01f0f"
        }
      ]
    },
    "lesson-13-quiero-no-quiero-segment-17": {
      "segments": [
        {
          "text": "And now: I do not want coffee.",
          "lang": "en",
          "file": "lesson-13-quiero-no-quiero-segment-17-1.mp3",
          "hash": "ca775204d96ab13fa942e4536b51072f86e0fddadd7aadaa7c0d60e4b8163194"
        }
      ]
    },
    "lesson-13-quiero-no-quiero-segment-18": {
      "segments": [
        {
          "text": "No quiero café.",
          "lang": "es",
          "file": "lesson-13-quiero-no-quiero-segment-18-1.mp3",
          "hash": "cf67ab9180fc48d0445346dac4d99f326046be3d981add9610cc18d2ec1a7a1a"
        }
      ]
    },
    "lesson-13-quiero-no-quiero-segment-19": {
      "segments": [
        {
          "text": "Good. Same sentence, one word parked in front.",
          "lang": "en",
          "file": "lesson-13-quiero-no-quiero-segment-19-1.mp3",
          "hash": "c6b2e8347dbb8b15790f7f95d8b589872077c78d4bb894cf20e9b7d9072e9c7a"
        }
      ]
    },
    "lesson-14-tion-cion-segment-1": {
      "segments": [
        {
          "text": "That common English ending is secretly a Spanish word machine.",
          "lang": "en",
          "file": "lesson-14-tion-cion-segment-1-1.mp3",
          "hash": "a42948073e946c430b106263899acb63153df05df3d1d8c034dfdb2046acddab"
        }
      ]
    },
    "lesson-14-tion-cion-segment-2": {
      "segments": [
        {
          "text": "When English says tion, Spanish often writes cion.",
          "lang": "en",
          "file": "lesson-14-tion-cion-segment-2-1.mp3",
          "hash": "df3eac8846eed2787ea68eaa5a6e54c441a230bb3f18855681a31caeb6916a7d"
        }
      ]
    },
    "lesson-14-tion-cion-segment-3": {
      "segments": [
        {
          "text": "But Spanish puts the stress at the end.",
          "lang": "en",
          "file": "lesson-14-tion-cion-segment-3-1.mp3",
          "hash": "ab1e10f9bc5a72fd9fc8b4b27d7220fe59d210ce4ea14d73099938f959c0c8a9"
        }
      ]
    },
    "lesson-14-tion-cion-segment-4": {
      "segments": [
        {
          "text": "Try the English word preparation.",
          "lang": "en",
          "file": "lesson-14-tion-cion-segment-4-1.mp3",
          "hash": "8be552baa869049594a0382d361166155cb81f81f526138383c4f25da50db065"
        }
      ]
    },
    "lesson-14-tion-cion-segment-5": {
      "segments": [
        {
          "text": "En español, preparación.",
          "lang": "es",
          "file": "lesson-14-tion-cion-segment-5-1.mp3",
          "hash": "a3bfffa099d0e2d6aa859446b5189cdd67b1af47bbd13829040d3bbc234c8e06"
        }
      ]
    },
    "lesson-14-tion-cion-segment-6": {
      "segments": [
        {
          "text": "What about organization?",
          "lang": "en",
          "file": "lesson-14-tion-cion-segment-6-1.mp3",
          "hash": "4d114ff03fb082b8a306f28c68fad8c09d3d59968f150348238fbaf49f578ca6"
        }
      ]
    },
    "lesson-14-tion-cion-segment-7": {
      "segments": [
        {
          "text": "En español, organización.",
          "lang": "es",
          "file": "lesson-14-tion-cion-segment-7-1.mp3",
          "hash": "756a86978b738ff4ee407d5c162d3ad4271fe56956dccda2c0d89f2e08bfd2c2"
        }
      ]
    },
    "lesson-14-tion-cion-segment-8": {
      "segments": [
        {
          "text": "Now generation.",
          "lang": "en",
          "file": "lesson-14-tion-cion-segment-8-1.mp3",
          "hash": "a8919a66fa388eaa5b897fee019c11d5b6ecd5dcd9d1b976737b0d65d3c03973"
        }
      ]
    },
    "lesson-14-tion-cion-segment-9": {
      "segments": [
        {
          "text": "En español, generación.",
          "lang": "es",
          "file": "lesson-14-tion-cion-segment-9-1.mp3",
          "hash": "c349bdd4bd47b201f0554d8fcef64354277f7a90688f8162c7bf6b3647da7eec"
        }
      ]
    },
    "lesson-14-tion-cion-segment-10": {
      "segments": [
        {
          "text": "Hear that first G? In Spanish, it has the soft throat sound.",
          "lang": "en",
          "file": "lesson-14-tion-cion-segment-10-1.mp3",
          "hash": "c3f043696d0f073346690863259c68cff2b1a16c83515cd65adff3e51d6a7b39"
        }
      ]
    },
    "lesson-14-tion-cion-segment-11": {
      "segments": [
        {
          "text": "Try it again: generation.",
          "lang": "en",
          "file": "lesson-14-tion-cion-segment-11-1.mp3",
          "hash": "0308faafadcbaf1bc2d9ec0f2608a39e5281fc7c7b73318a6933f2f7ce7b58d8"
        }
      ]
    },
    "lesson-14-tion-cion-segment-12": {
      "segments": [
        {
          "text": "En español, generación.",
          "lang": "es",
          "file": "lesson-14-tion-cion-segment-12-1.mp3",
          "hash": "c349bdd4bd47b201f0554d8fcef64354277f7a90688f8162c7bf6b3647da7eec"
        }
      ]
    },
    "lesson-14-tion-cion-segment-13": {
      "segments": [
        {
          "text": "And confirmation.",
          "lang": "en",
          "file": "lesson-14-tion-cion-segment-13-1.mp3",
          "hash": "b30669fcc9781e818d3cd30acc1a9500d86ef0c8d391d1ce5d2d2f24c239e948"
        }
      ]
    },
    "lesson-14-tion-cion-segment-14": {
      "segments": [
        {
          "text": "En español, confirmación.",
          "lang": "es",
          "file": "lesson-14-tion-cion-segment-14-1.mp3",
          "hash": "0d712427e09fea913842e9b64ac728c4cc65c2739bea68ef05cfbf95fe065902"
        }
      ]
    },
    "lesson-14-tion-cion-segment-15": {
      "segments": [
        {
          "text": "Good. You used English as a map, then cleaned off the English sound.",
          "lang": "en",
          "file": "lesson-14-tion-cion-segment-15-1.mp3",
          "hash": "31f64450dc2b44030e5eae2400d0ec1fee0de5beabfebf9899f3b9b6013ad49f"
        }
      ]
    }
  }
}
