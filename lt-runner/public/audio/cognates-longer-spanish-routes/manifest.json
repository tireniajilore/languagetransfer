        }
      ]
    },
    "lesson-21-r-sound-segment-1": {
      "segments": [
        {
          "text": "The Spanish are sound scares people more than it should.",
          "lang": "en",
          "file": "lesson-21-r-sound-segment-1-1.mp3",
          "hash": "54ca1376d175e468bf29d14fe0dfbbb8cf4f932ad1dfcfcd159641ee3ee0ba5c"
        }
      ]
    },
    "lesson-21-r-sound-segment-2": {
      "segments": [
        {
          "text": "At the start of a word, this sound gets the stronger flick.",
          "lang": "en",
          "file": "lesson-21-r-sound-segment-2-1.mp3",
          "hash": "7a6886d22449542500aba99744b97e7d275fb3f8a9a31e69219faeba2464f0f0"
        }
      ]
    },
    "lesson-21-r-sound-segment-3": {
      "segments": [
        {
          "text": "Try the English word regular, with Spanish sound.",
          "lang": "en",
          "file": "lesson-21-r-sound-segment-3-1.mp3",
          "hash": "e43e6b2712713c503dd753c9b6f57dc9e0a11137afc0d046c699188d7f97023c"
        }
      ]
    },
    "lesson-21-r-sound-segment-4": {
      "segments": [
        {
          "text": "En español, regular.",
          "lang": "es",
          "file": "lesson-21-r-sound-segment-4-1.mp3",
          "hash": "e163ab7e34d198293e184b67ae51e1a9e996335ec8544f81dfc2189d5de6eb93"
        }
      ]
    },
    "lesson-21-r-sound-segment-5": {
      "segments": [
        {
          "text": "And real, with that same first sound.",
          "lang": "en",
          "file": "lesson-21-r-sound-segment-5-1.mp3",
          "hash": "7d27f1efd27ce88211530496b4738cfc51d5f823b3bff9ee3e1c732e8aabfda4"
        }
      ]
    },
    "lesson-21-r-sound-segment-6": {
      "segments": [
        {
          "text": "En español, real.",
          "lang": "es",
          "file": "lesson-21-r-sound-segment-6-1.mp3",
          "hash": "f9f19ad167c54ccb692b3048ccf5423e904b1be057cbb7bb1440e3d6e096531f"
        }
      ]
    },
    "lesson-21-r-sound-segment-7": {
      "segments": [
        {
          "text": "Inside a word, a single are sound is lighter.",
          "lang": "en",
          "file": "lesson-21-r-sound-segment-7-1.mp3",
          "hash": "cc9e1edec97e89b0539333854c5f05b5efba7d47f68619f3dbe547ab18775254"
        }
      ]
    },
    "lesson-21-r-sound-segment-8": {
      "segments": [
        {
          "text": "Escucha: pero.",
          "lang": "es",
          "file": "lesson-21-r-sound-segment-8-1.mp3",
          "hash": "6148382954e5fee614b18bd6c44babbb7b528e1c6f447fd2e9c509b95a0cbf8a"
        }
      ]
    },
    "lesson-21-r-sound-segment-9": {
      "segments": [
        {
          "text": "But double are gets the stronger sound again.",
          "lang": "en",
          "file": "lesson-21-r-sound-segment-9-1.mp3",
          "hash": "38eccbe3e793aa2fd668d484eab751331e13f8d73092a4c2ddcee6c8bae7ec46"
        }
      ]
    },
    "lesson-21-r-sound-segment-10": {
      "segments": [
        {
          "text": "Escucha: perro.",
          "lang": "es",
          "file": "lesson-21-r-sound-segment-10-1.mp3",
          "hash": "195d334299291ca071e805e9ac1035e00394a2f971df21bb275528ffb5bf0dbc"
        }
      ]
    },
    "lesson-21-r-sound-segment-11": {
      "segments": [
        {
          "text": "If the strong sound does not come out yet, do not let it stop you.",
