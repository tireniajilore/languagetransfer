          "file": "lesson-22-long-route-verbs-segment-13-1.mp3",
          "hash": "12b5fdec1e9d81ec55a721b024d7cffcc929f57301bc738447aeae5001e3b6f8"
        }
      ]
    },
    "lesson-22-long-route-verbs-segment-14": {
      "segments": [
        {
          "text": "En español, participar.",
          "lang": "es",
          "file": "lesson-22-long-route-verbs-segment-14-1.mp3",
          "hash": "1c167f4fc142315ede0c71734cdbbee9f4e9a8ee13e04a720bb3703c2c52dcd3"
        }
      ]
    },
    "lesson-22-long-route-verbs-segment-15": {
      "segments": [
        {
          "text": "Creation gives the same pattern.",
