    "lesson-22-long-route-verbs-segment-5": {
      "segments": [
        {
          "text": "Generación.",
          "lang": "es",
          "file": "lesson-22-long-route-verbs-segment-5-1.mp3",
          "hash": "4c9fda93222706820bdc1526dbe427e319ca7ec76168a8a350eed3d8f4f37de0"
        }
      ]
    },
    "lesson-22-long-route-verbs-segment-6": {
      "segments": [
        {
          "text": "Then take off ción and add ar.",
