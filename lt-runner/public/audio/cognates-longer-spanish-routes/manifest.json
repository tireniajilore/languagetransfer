          "hash": "75b1eda08c38fa5b0db5dab23700de25d81908a2a0c6f089e514d68352426bd4"
        }
      ]
    },
    "lesson-20-lo-cancelarlo-segment-4": {
      "segments": [
        {
          "text": "When the verb is unchanged, lo can attach to the end.",
