        }
      ]
    },
    "lesson-20-lo-cancelarlo-segment-5": {
      "segments": [
        {
          "text": "Cancel becomes cancelar.",
          "lang": "en",
          "file": "lesson-20-lo-cancelarlo-segment-5-1.mp3",
