          "file": "lesson-22-long-route-verbs-segment-11-1.mp3",
          "hash": "fce003c9fba0a5c4a15a9097da3fce18392defdb455336750be3a0283fff2560"
        }
      ]
    },
    "lesson-22-long-route-verbs-segment-12": {
      "segments": [
        {
          "text": "Participation becomes participación.",
