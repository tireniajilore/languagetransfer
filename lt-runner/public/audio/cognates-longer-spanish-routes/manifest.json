          "hash": "c928f97b66ccf5b383dd72795ad7bb854cd1356756155de925979adedf6faba9"
        }
      ]
    },
    "lesson-23-ence-ance-segment-13": {
      "segments": [
        {
          "text": "En español, distancia.",
          "lang": "es",
          "file": "lesson-23-ence-ance-segment-13-1.mp3",
          "hash": "eadd619da7d4a7b06521751de7aecf1f5ee1c1fa824faa20ad2a713be0c66e50"
        }
      ]
    },
    "lesson-23-ence-ance-segment-14": {
      "segments": [
        {
          "text": "One more: consistency.",
          "lang": "en",
          "file": "lesson-23-ence-ance-segment-14-1.mp3",
          "hash": "01a38de25c3984bff2e8bb83b30696309feef65e8b0246520796a3435de6d50b"
