          "hash": "e06a6029ef07cf7c820d67210c7dbc098a26a1178bc804f6e476e6c7ff32fa79"
        }
      ]
    },
    "lesson-22-long-route-verbs-segment-17": {
      "segments": [
        {
          "text": "En español, crear.",
          "lang": "es",
          "file": "lesson-22-long-route-verbs-segment-17-1.mp3",
