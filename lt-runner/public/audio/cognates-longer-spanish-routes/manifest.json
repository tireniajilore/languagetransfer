          "file": "lesson-23-ence-ance-segment-2-1.mp3",
          "hash": "62096c61055bc4c63d4235ccd9c03338914fd1a166eb9cc8ecd2a8fefef33f85"
        }
      ]
    },
    "lesson-23-ence-ance-segment-3": {
      "segments": [
        {
          "text": "Experience becomes experiencia.",
          "lang": "en",
          "file": "lesson-23-ence-ance-segment-3-1.mp3",
          "hash": "e814d65c1e11d400955e577e0704a0b5a7d2f8aebae834863c542e87bf6481db"
        }
      ]
    },
    "lesson-23-ence-ance-segment-4": {
      "segments": [
        {
          "text": "En español, experiencia.",
          "lang": "es",
          "file": "lesson-23-ence-ance-segment-4-1.mp3",
          "hash": "63d744916ab93707882a264e4847be3b14b503c9255e5bbeeb181b18c775a673"
        }
      ]
    },
    "lesson-23-ence-ance-segment-5": {
      "segments": [
        {
          "text": "You know different. Now try difference.",
          "lang": "en",
          "file": "lesson-23-ence-ance-segment-5-1.mp3",
          "hash": "be83ed5f067019c7f9d00a8391d6260daf2423933485ddd07b144b3ea191b7a5"
