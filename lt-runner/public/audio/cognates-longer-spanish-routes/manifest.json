          "hash": "3bde96bf7a8fdedd5c0e5caab8fbf5c2865b4d2d63b28ec520977b25219a5bfe"
        }
      ]
    },
    "lesson-22-long-route-verbs-segment-8": {
      "segments": [
        {
          "text": "En español, generar.",
          "lang": "es",
          "file": "lesson-22-long-route-verbs-segment-8-1.mp3",
          "hash": "d6eea0c031aae24468975a01a065fe013bb215e293af535b88f54795b246b947"
        }
      ]
    },
    "lesson-22-long-route-verbs-segment-9": {
      "segments": [
        {
          "text": "Same long route: situation becomes situación.",
          "lang": "en",
          "file": "lesson-22-long-route-verbs-segment-9-1.mp3",
          "hash": "c25d4449d3b8cabc235720f0d51be165333d67d37b11c007116cd9c2010b993f"
        }
      ]
    },
    "lesson-22-long-route-verbs-segment-10": {
      "segments": [
        {
          "text": "Now turn it into: to situate.",
          "lang": "en",
          "file": "lesson-22-long-route-verbs-segment-10-1.mp3",
          "hash": "cf27c27b9315c8ed90a7df79103ac8ed039d00b82e521f83eba957526ade29e2"
        }
      ]
    },
    "lesson-22-long-route-verbs-segment-11": {
      "segments": [
        {
          "text": "En español, situar.",
