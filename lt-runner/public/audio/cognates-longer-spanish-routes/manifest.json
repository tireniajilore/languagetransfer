    },
    "lesson-20-lo-cancelarlo-segment-13": {
      "segments": [
        {
          "text": "Quiero cancelarlo.",
          "lang": "es",
          "file": "lesson-20-lo-cancelarlo-segment-13-1.mp3",
          "hash": "24539f2570c816f6614aa38fa8def511466df515d0724135827c50ef30ae6604"
        }
      ]
    },
    "lesson-20-lo-cancelarlo-segment-14": {
      "segments": [
        {
          "text": "One more thing: lo can also mean him.",
