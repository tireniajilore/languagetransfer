          "file": "lesson-20-lo-cancelarlo-segment-16-1.mp3",
          "hash": "e0cc02692a087926a8c7f9a21d46ae9498932a9d8635b9388f753eceb883ca59"
        }
      ]
    },
    "lesson-20-lo-cancelarlo-segment-17": {
      "segments": [
        {
