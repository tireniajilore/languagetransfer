    "lesson-23-ence-ance-segment-7": {
      "segments": [
        {
          "text": "What about influence?",
          "lang": "en",
          "file": "lesson-23-ence-ance-segment-7-1.mp3",
          "hash": "6e4bde27cdfc5027e5b6aef1d36860c5c06084df7ef2d3f7d777cc2b9ae9ca09"
        }
