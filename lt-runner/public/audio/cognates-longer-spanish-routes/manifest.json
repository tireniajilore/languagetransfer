        }
      ]
    },
    "lesson-23-ence-ance-segment-9": {
      "segments": [
        {
          "text": "And when English ends in the ending spelled A N C E, Spanish often has ancia.",
          "lang": "en",
          "file": "lesson-23-ence-ance-segment-9-1.mp3",
          "hash": "969b7b1878aa79fb1fe1dcdd100df9548a530f52e898c5775809ab08b7088d41"
        }
      ]
    },
    "lesson-23-ence-ance-segment-10": {
      "segments": [
        {
          "text": "Important gave you importante. Now importance gives you importancia.",
          "lang": "en",
          "file": "lesson-23-ence-ance-segment-10-1.mp3",
          "hash": "1e21305a42d3bfe699f4103dbefc991ebe3bed6cdf2b6a81e3273019fc1f9a27"
        }
      ]
    },
    "lesson-23-ence-ance-segment-11": {
      "segments": [
        {
          "text": "En español, importancia.",
          "lang": "es",
          "file": "lesson-23-ence-ance-segment-11-1.mp3",
          "hash": "dda9c748f6d0bff796de9d7fa11e4d742155670d7fb79cbc6fc804909103f877"
        }
      ]
    },
    "lesson-23-ence-ance-segment-12": {
      "segments": [
        {
          "text": "Try distance.",
          "lang": "en",
