          "file": "lesson-21-r-sound-segment-11-1.mp3",
          "hash": "fa22da85772833e249e9335cf398e738c394a05f949d0f6265004726d443a1ba"
        }
      ]
    },
    "lesson-21-r-sound-segment-12": {
      "segments": [
        {
          "text": "Keep listening. Keep the mouth relaxed. The sound can arrive later.",
          "lang": "en",
          "file": "lesson-21-r-sound-segment-12-1.mp3",
          "hash": "69d2be0d7afed6715a8648ac7549427ac3c50a6a9de9b695310ab4ab119bb125"
        }
      ]
    },
    "lesson-22-long-route-verbs-segment-1": {
      "segments": [
        {
          "text": "The slow route is how you stop guessing Spanish verbs.",
          "lang": "en",
          "file": "lesson-22-long-route-verbs-segment-1-1.mp3",
          "hash": "c3768eb18324eacec21cfbc8eacbd4d8491af01a607cb520910435d1b2cf2fc2"
        }
      ]
    },
    "lesson-22-long-route-verbs-segment-2": {
      "segments": [
        {
          "text": "Do not jump from the short English verb.",
