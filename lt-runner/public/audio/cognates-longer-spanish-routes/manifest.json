          "hash": "12aa418bdaee1a6064aaec409cca0310842c34ba94a58d5f0290191af36b5593"
        }
      ]
    },
    "lesson-20-lo-cancelarlo-segment-22": {
      "segments": [
        {
          "text": "Quiero salvarlo.",
