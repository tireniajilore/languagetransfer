          "hash": "98250d975dd440600b3c2ef5f1c4358a7ae1e2b73c1bab6ed84e62eb4a2d9ea2"
        }
      ]
    },
    "lesson-22-long-route-verbs-segment-3": {
      "segments": [
        {
          "text": "Use the bigger English noun first.",
          "lang": "en",
          "file": "lesson-22-long-route-verbs-segment-3-1.mp3",
          "hash": "62c5cf711066c3c7e2eb0fb37766c15bb773c3512fde5ec37c127e9edfdf9798"
        }
      ]
    },
    "lesson-22-long-route-verbs-segment-4": {
      "segments": [
        {
          "text": "Generate can go through generation.",
          "lang": "en",
          "file": "lesson-22-long-route-verbs-segment-4-1.mp3",
          "hash": "57574b1b3f8265e9e0bd9459adfeaa30f18376cbb06f6cdebcf6a67548200e48"
