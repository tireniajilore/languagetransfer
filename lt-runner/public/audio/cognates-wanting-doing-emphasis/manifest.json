    "lesson-17-yo-emphasis-segment-1": {
      "segments": [
        {
          "text": "Do not say yo every time English says I.",
          "lang": "en",
          "file": "lesson-17-yo-emphasis-segment-1-1.mp3",
          "hash": "a78875dd7dd40794078100b38abc68783d8669027859bbb28278d4926a5bb685"
