      "segments": [
        {
          "text": "For the negative, no still goes right before quiero.",
          "lang": "en",
          "file": "lesson-17-yo-emphasis-segment-13-1.mp3",
          "hash": "04f1ce9222529b46484468b1874288070f5a4f9ef96b210050a9f039a9b7a53d"
        }
      ]
    },
    "lesson-17-yo-emphasis-segment-14": {
      "segments": [
        {
          "text": "Say: I do not want, with emphasis.",
          "lang": "en",
          "file": "lesson-17-yo-emphasis-segment-14-1.mp3",
          "hash": "59419e3a7d9604c2afad236f9219f51624f1e8b7c71f3067130c45f1e24267f6"
        }
      ]
    },
    "lesson-17-yo-emphasis-segment-15": {
      "segments": [
        {
          "text": "Yo no quiero.",
          "lang": "es",
          "file": "lesson-17-yo-emphasis-segment-15-1.mp3",
          "hash": "2219ad1514f3e36dd9ebf9577fe12e7da769f81f86a61e3c529cb674e70739da"
        }
      ]
    },
    "lesson-17-yo-emphasis-segment-16": {
      "segments": [
        {
          "text": "Use yo when you are contrasting, correcting, or making your own choice clear.",
          "lang": "en",
          "file": "lesson-17-yo-emphasis-segment-16-1.mp3",
          "hash": "51ecf64bc30875f7f2965955090b73172dd95cd6a365f87b573d205ab535ec66"
        }
      ]
    },
    "lesson-18-me-informarme-segment-1": {
      "segments": [
        {
          "text": "Spanish has a tiny trick for saying me.",
          "lang": "en",
          "file": "lesson-18-me-informarme-segment-1-1.mp3",
          "hash": "b8cc3da90d6f93acc4961b93d8a5b65cddd6402f8d10f89fa3d98b0890972284"
        }
      ]
    },
    "lesson-18-me-informarme-segment-2": {
      "segments": [
        {
          "text": "In English, prepare me usually means prepare myself.",
          "lang": "en",
          "file": "lesson-18-me-informarme-segment-2-1.mp3",
          "hash": "ef84fa134e217fb14935a7928589d0a92fd5b7700276a5af67d5a0a240f6250b"
        }
      ]
    },
    "lesson-18-me-informarme-segment-3": {
      "segments": [
        {
          "text": "Start with prepare. In Spanish, preparar.",
          "lang": "en",
          "file": "lesson-18-me-informarme-segment-3-1.mp3",
          "hash": "c67bfcc38d3b1e3e91fbdf4b9275750dc6439d920331588d07b7d40fdc32d88d"
        }
      ]
    },
    "lesson-18-me-informarme-segment-4": {
      "segments": [
        {
          "text": "Preparar.",
          "lang": "es",
          "file": "lesson-18-me-informarme-segment-4-1.mp3",
          "hash": "61254f0ca5be9c0687017091be8188480366c5b54d763a0755b37b4a7107c782"
        }
      ]
    },
    "lesson-18-me-informarme-segment-5": {
      "segments": [
        {
          "text": "Now put me at the end.",
          "lang": "en",
          "file": "lesson-18-me-informarme-segment-5-1.mp3",
          "hash": "cec7ac1c9706f7ae6915e93fef653b7a9e76228d4503e6dad1baf484fe7e86d0"
        }
      ]
    },
    "lesson-18-me-informarme-segment-6": {
      "segments": [
        {
          "text": "Say: to prepare myself.",
          "lang": "en",
          "file": "lesson-18-me-informarme-segment-6-1.mp3",
          "hash": "246bdec8daa7fc1ffbf7eef521859e55c4af7d69055c6b84ad01157e9e74f744"
        }
      ]
    },
    "lesson-18-me-informarme-segment-7": {
      "segments": [
        {
          "text": "En español, prepararme.",
          "lang": "es",
          "file": "lesson-18-me-informarme-segment-7-1.mp3",
          "hash": "4e98ec65ee8f01bcf17811877fb4f8c58dd9f9ab9abc38cafa7d5063db892626"
        }
      ]
    },
    "lesson-18-me-informarme-segment-8": {
      "segments": [
        {
          "text": "Good. Same verb. You just attached me.",
          "lang": "en",
          "file": "lesson-18-me-informarme-segment-8-1.mp3",
          "hash": "6fad4e77bf66273887382dd98c17eafb338e56cc772dcea492812a77211b3ee7"
        }
      ]
    },
    "lesson-18-me-informarme-segment-9": {
      "segments": [
        {
          "text": "Now use the old ation pattern.",
          "lang": "en",
          "file": "lesson-18-me-informarme-segment-9-1.mp3",
          "hash": "da18e183c458329f97f75759170e5271da50f19c932be766f7177f6ee32a58f3"
        }
      ]
    },
    "lesson-18-me-informarme-segment-10": {
      "segments": [
        {
          "text": "Organization gives organización, then organizar.",
          "lang": "en",
          "file": "lesson-18-me-informarme-segment-10-1.mp3",
          "hash": "5cc3d137a76ee762ca5b2cac562e36ac589af2817d24476010ee549c276a37aa"
        }
      ]
    },
    "lesson-18-me-informarme-segment-11": {
      "segments": [
        {
          "text": "Now say: to organize myself.",
          "lang": "en",
          "file": "lesson-18-me-informarme-segment-11-1.mp3",
          "hash": "b91338b83e8b5e408622b30e24272a646440b67aaccd6afd72db50d53ac7ef4d"
        }
      ]
    },
    "lesson-18-me-informarme-segment-12": {
      "segments": [
        {
          "text": "En español, organizarme.",
          "lang": "es",
          "file": "lesson-18-me-informarme-segment-12-1.mp3",
          "hash": "3d159d4a2acf25212c6fab881d6f8ad42f766ffd3b717dcc7b368ce7d9d2f58f"
        }
      ]
    },
    "lesson-18-me-informarme-segment-13": {
      "segments": [
        {
          "text": "One more. Information gives información, then informar.",
          "lang": "en",
          "file": "lesson-18-me-informarme-segment-13-1.mp3",
          "hash": "31d4a139a1930a067ab6ece30b9fb626a4f4f026aceab00c6fa1ca7d25f25ceb"
        }
      ]
    },
    "lesson-18-me-informarme-segment-14": {
      "segments": [
        {
          "text": "Attach me: to inform me.",
          "lang": "en",
          "file": "lesson-18-me-informarme-segment-14-1.mp3",
          "hash": "94adfb176af38433c3bb2f577dd8acaf95af11f5ce41c53d7c5109f39779790b"
        }
      ]
    },
    "lesson-18-me-informarme-segment-15": {
      "segments": [
        {
          "text": "En español, informarme.",
          "lang": "es",
          "file": "lesson-18-me-informarme-segment-15-1.mp3",
          "hash": "d7c45d9b6ce3013894385b64f91fcf4adebd7f05462d1265e8f3f2d7349201b5"
        }
      ]
    },
    "lesson-18-me-informarme-segment-16": {
      "segments": [
        {
          "text": "Same idea: inform me usually means inform myself.",
          "lang": "en",
          "file": "lesson-18-me-informarme-segment-16-1.mp3",
          "hash": "1f9def00519e754a8181ab4d614134547aa685332ddf68b91ed0dab77bd46c8d"
        }
      ]
    },
    "lesson-18-me-informarme-segment-17": {
      "segments": [
        {
          "text": "And Spanish often uses that for find out.",
          "lang": "en",
          "file": "lesson-18-me-informarme-segment-17-1.mp3",
          "hash": "52d0103cec357801a83f004f0cf13e2f465e34c62368c9ee128af129c19b52e8"
        }
      ]
    },
    "lesson-18-me-informarme-segment-18": {
      "segments": [
        {
          "text": "Now say: I want to find out.",
          "lang": "en",
          "file": "lesson-18-me-informarme-segment-18-1.mp3",
          "hash": "5061a71062a22a5fa2a8bfc36b65baacc2aa5e58ab1dbd2a5467b6e89adc099b"
        }
      ]
    },
    "lesson-18-me-informarme-segment-19": {
      "segments": [
        {
          "text": "Quiero informarme.",
          "lang": "es",
          "file": "lesson-18-me-informarme-segment-19-1.mp3",
          "hash": "a22e38bf7102b09efe709a045d217d5cdb879171c263b1f1f40c06f33dbdce54"
        }
      ]
    },
    "lesson-18-me-informarme-segment-20": {
      "segments": [
        {
          "text": "Good. Do not learn a new sentence. Build the verb, then attach me.",
          "lang": "en",
          "file": "lesson-18-me-informarme-segment-20-1.mp3",
          "hash": "62ca4d056a9311f5712937f2b1425b821fb34e1ca3e5d82aedaa639530323cab"
        }
      ]
    },
    "lesson-19-te-obligarte-segment-1": {
      "segments": [
        {
          "text": "Spanish has the same tiny trick for saying you.",
          "lang": "en",
          "file": "lesson-19-te-obligarte-segment-1-1.mp3",
          "hash": "6aca711d012e4160258c9b25f82e25302743b89a3930243a0a516fe7ff812251"
        }
      ]
    },
    "lesson-19-te-obligarte-segment-2": {
      "segments": [
        {
          "text": "The word is te.",
          "lang": "en",
          "file": "lesson-19-te-obligarte-segment-2-1.mp3",
          "hash": "042d4fcd6db14aba331c86cde9251e7653a94c5d765596cd7680c12e83220ab1"
        }
      ]
    },
    "lesson-19-te-obligarte-segment-3": {
      "segments": [
        {
          "text": "Here, te means you.",
          "lang": "en",
          "file": "lesson-19-te-obligarte-segment-3-1.mp3",
          "hash": "58c2677b5fb361a0782bc233228be6c8233f8460f4d1adc572e97a79b786c51b"
        }
      ]
    },
    "lesson-19-te-obligarte-segment-4": {
      "segments": [
        {
          "text": "Start with inform. In Spanish, informar.",
          "lang": "en",
          "file": "lesson-19-te-obligarte-segment-4-1.mp3",
          "hash": "e721defb300500c5c3e8cd6cd17a1429794c84656892cc5fe72f03751f1c925f"
        }
      ]
    },
    "lesson-19-te-obligarte-segment-5": {
      "segments": [
        {
          "text": "Informar.",
          "lang": "es",
          "file": "lesson-19-te-obligarte-segment-5-1.mp3",
          "hash": "ded16dd00a5249ff0a8b8f5e9770f3ec66039bae9dae9de8ff271a683888354c"
        }
      ]
    },
    "lesson-19-te-obligarte-segment-6": {
      "segments": [
        {
          "text": "Attach te at the end.",
          "lang": "en",
          "file": "lesson-19-te-obligarte-segment-6-1.mp3",
          "hash": "bbd153093b8c4e94310c7da1ad8ce52805d3677940172f0439ee131841080fa1"
        }
      ]
    },
    "lesson-19-te-obligarte-segment-7": {
      "segments": [
        {
          "text": "Say: to inform you.",
          "lang": "en",
          "file": "lesson-19-te-obligarte-segment-7-1.mp3",
          "hash": "66674d512b00404cc7a2de4a0c42a5856c79b79c7f8e995c749dbace16b9dd86"
        }
      ]
    },
    "lesson-19-te-obligarte-segment-8": {
      "segments": [
        {
          "text": "En español, informarte.",
          "lang": "es",
          "file": "lesson-19-te-obligarte-segment-8-1.mp3",
          "hash": "8e2e0e5ef5730784a6326d4ceeba23a6ff2c1dc2a1b2527a91f973576b6f49a9"
        }
      ]
    },
    "lesson-19-te-obligarte-segment-9": {
      "segments": [
        {
          "text": "Quiero.",
          "lang": "es",
          "file": "lesson-19-te-obligarte-segment-9-1.mp3",
          "hash": "353e0a80b68bddbcea4a0dd11024f9712e530fafe3643453f814e3d8d889c638"
        }
      ]
    },
    "lesson-19-te-obligarte-segment-10": {
      "segments": [
        {
          "text": "Quick reminder: quiero means I want.",
          "lang": "en",
          "file": "lesson-19-te-obligarte-segment-10-1.mp3",
          "hash": "f055ea02d1463bd79198e30d61ac9cee924d48f029e30e38c88e07981ceb961d"
        }
      ]
    },
    "lesson-19-te-obligarte-segment-11": {
      "segments": [
        {
          "text": "Now say: I want to inform you.",
          "lang": "en",
          "file": "lesson-19-te-obligarte-segment-11-1.mp3",
          "hash": "3dfca606883d7a64df03d0dcfcd20fadee252925a30447b428bf64bcaf77911f"
        }
      ]
    },
    "lesson-19-te-obligarte-segment-12": {
      "segments": [
        {
          "text": "Quiero informarte.",
          "lang": "es",
          "file": "lesson-19-te-obligarte-segment-12-1.mp3",
          "hash": "c66b96fa7e6c81a9d003c81cc93b90da8464c1a67f1a41ea7f9480dbab077622"
        }
      ]
    },
    "lesson-19-te-obligarte-segment-13": {
      "segments": [
        {
          "text": "Good. Now we can handle a more serious verb.",
          "lang": "en",
          "file": "lesson-19-te-obligarte-segment-13-1.mp3",
          "hash": "1abbf67004c5d28347ffe318ef3bb66c079acf09c323e00fa6eb9c307d5973a8"
        }
      ]
    },
    "lesson-19-te-obligarte-segment-14": {
      "segments": [
        {
          "text": "Obligation becomes obligación, then obligar.",
          "lang": "en",
          "file": "lesson-19-te-obligarte-segment-14-1.mp3",
          "hash": "72c057523d64fa5dabbec6375d82fc4483bbfcb1603988dfa5d8af5b6d26d6eb"
        }
      ]
    },
    "lesson-19-te-obligarte-segment-15": {
      "segments": [
        {
          "text": "Attach you: to oblige you.",
          "lang": "en",
          "file": "lesson-19-te-obligarte-segment-15-1.mp3",
          "hash": "8837b4d350c04c7a3432b320b84df9d3641bc6bcf377ecffaf1df344eeadc507"
        }
      ]
    },
    "lesson-19-te-obligarte-segment-16": {
      "segments": [
        {
          "text": "En español, obligarte.",
          "lang": "es",
          "file": "lesson-19-te-obligarte-segment-16-1.mp3",
          "hash": "60352804e52df29b1a548f69df8ec6a293cb5955e5647e0c66c96e10f3fd1005"
        }
      ]
    },
    "lesson-19-te-obligarte-segment-17": {
      "segments": [
        {
          "text": "Say: I do not want to oblige you.",
          "lang": "en",
          "file": "lesson-19-te-obligarte-segment-17-1.mp3",
          "hash": "182f8d851de4955378fbde771b4232ecf7f052ac72bc6a4f45ae35bfba1c8106"
        }
      ]
    },
    "lesson-19-te-obligarte-segment-18": {
      "segments": [
        {
          "text": "No quiero obligarte.",
          "lang": "es",
          "file": "lesson-19-te-obligarte-segment-18-1.mp3",
          "hash": "fc854c1797ed2a4799d95b6ba617ee4d98016455883d1336fe51efb5a31b7d3d"
        }
      ]
    },
    "lesson-19-te-obligarte-segment-19": {
      "segments": [
        {
          "text": "One stretch: provocation gives provocar.",
          "lang": "en",
          "file": "lesson-19-te-obligarte-segment-19-1.mp3",
          "hash": "8b8c01a3336f3e3f862766c9d7a0930c62b16802b795bd51a9431e4f23c1afa6"
        }
      ]
    },
    "lesson-19-te-obligarte-segment-20": {
      "segments": [
        {
          "text": "Now say: I do not want to provoke you.",
          "lang": "en",
          "file": "lesson-19-te-obligarte-segment-20-1.mp3",
          "hash": "78fa30a693d2fe5a48e1b749b31b4590e73b47bfb8111ebe4030bea79a15c940"
        }
      ]
    },
    "lesson-19-te-obligarte-segment-21": {
      "segments": [
        {
          "text": "No quiero provocarte.",
          "lang": "es",
          "file": "lesson-19-te-obligarte-segment-21-1.mp3",
          "hash": "832eafe88e0ccb18a5aaa7bddd880b5ffc2dfb9a2ecec9eebc85f93b562a01e7"
        }
      ]
    },
    "lesson-19-te-obligarte-segment-22": {
      "segments": [
        {
          "text": "Good. Te stayed the same. Only the verb changed.",
          "lang": "en",
          "file": "lesson-19-te-obligarte-segment-22-1.mp3",
          "hash": "8b81015dc2222786e07a11d1ff66fd871a0cb9a6cc8b82512ca55ffbc3a9f9b7"
        }
      ]
    }
  }
}
