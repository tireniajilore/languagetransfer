    "lesson-17-yo-emphasis-segment-2": {
      "segments": [
        {
          "text": "Quiero.",
          "lang": "es",
          "file": "lesson-17-yo-emphasis-segment-2-1.mp3",
          "hash": "353e0a80b68bddbcea4a0dd11024f9712e530fafe3643453f814e3d8d889c638"
        }
      ]
    },
    "lesson-17-yo-emphasis-segment-3": {
      "segments": [
        {
          "text": "That already means I want.",
          "lang": "en",
          "file": "lesson-17-yo-emphasis-segment-3-1.mp3",
          "hash": "6492823506a04381ee6d6b08ff14d18a27774ae75244f86c357fccfa134b4ea9"
        }
      ]
    },
    "lesson-17-yo-emphasis-segment-4": {
      "segments": [
        {
          "text": "Quick check: say I want.",
          "lang": "en",
          "file": "lesson-17-yo-emphasis-segment-4-1.mp3",
          "hash": "ae95184598a3b6b80e60856612a698d20d86ad8beb1afa6efb1435bab0f0359c"
        }
      ]
    },
    "lesson-17-yo-emphasis-segment-5": {
      "segments": [
        {
          "text": "Quiero.",
          "lang": "es",
          "file": "lesson-17-yo-emphasis-segment-5-1.mp3",
          "hash": "353e0a80b68bddbcea4a0dd11024f9712e530fafe3643453f814e3d8d889c638"
        }
      ]
    },
    "lesson-17-yo-emphasis-segment-6": {
      "segments": [
        {
          "text": "The word yo means I.",
          "lang": "en",
          "file": "lesson-17-yo-emphasis-segment-6-1.mp3",
          "hash": "7b55fa01586cbf48d1d92516317b465441580ad5e139d063fa9c34b07c9d6be5"
        }
      ]
    },
    "lesson-17-yo-emphasis-segment-7": {
      "segments": [
        {
          "text": "But Spanish usually leaves it out, because the verb already tells you who.",
          "lang": "en",
          "file": "lesson-17-yo-emphasis-segment-7-1.mp3",
          "hash": "e4d23fb26978e90f2bed2023e8e9416c42cc87c06d5b7572c31fd95ba2f47af8"
        }
      ]
    },
    "lesson-17-yo-emphasis-segment-8": {
      "segments": [
        {
          "text": "Use yo when you want to stress who is doing it: I want it, not someone else.",
          "lang": "en",
          "file": "lesson-17-yo-emphasis-segment-8-1.mp3",
          "hash": "5f5d8c7c942d6f6fc59f7d2dfcb956fa5fefb386d93a4aa50badab4d0617441b"
        }
      ]
    },
    "lesson-17-yo-emphasis-segment-9": {
      "segments": [
        {
          "text": "Yo quiero.",
          "lang": "es",
          "file": "lesson-17-yo-emphasis-segment-9-1.mp3",
          "hash": "6dec9a806eda9e8cbfa144a7abd8469122a7ce1c76be350ad4ffec4a0d038f28"
        }
      ]
    },
    "lesson-17-yo-emphasis-segment-10": {
      "segments": [
        {
          "text": "That is not just neutral I want. It is more like me, I want.",
          "lang": "en",
          "file": "lesson-17-yo-emphasis-segment-10-1.mp3",
          "hash": "a160b2086434f75b9da8defa429db5a84de24ddfd3bdbaa7e1f90a51b64d497f"
        }
      ]
    },
    "lesson-17-yo-emphasis-segment-11": {
      "segments": [
        {
          "text": "Say I want, with that me, not them feeling.",
          "lang": "en",
          "file": "lesson-17-yo-emphasis-segment-11-1.mp3",
          "hash": "ebe122e1cf03949789cc956a2c85450477cf5b70c62648eaf531e79ed359f33f"
        }
      ]
    },
    "lesson-17-yo-emphasis-segment-12": {
      "segments": [
        {
